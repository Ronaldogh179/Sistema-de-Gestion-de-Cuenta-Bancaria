PORT=5000
# Instancia local con replica set de un solo nodo (creada por `npm run mongo:setup`).
# No se modifica el servicio MongoDB de Windows que escucha en 27017.
MONGODB_URI=mongodb://127.0.0.1:27018/cuenta_bancaria?replicaSet=rs0

# Opcional: puerto y nombre del replica set usados por scripts/setup-replset.js
MONGO_REPLSET_PORT=27018
MONGO_REPLSET_NAME=rs0
